---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import SectionIndex from '../components/SectionIndex.astro';
import Timeline from '../components/Timeline.astro';
import DatedList from '../components/DatedList.astro';
import { teaching, researchExperience } from '../data/experience';
import {
  conferences,
  workshops,
  responsibilities,
  awards,
  certificates,
  researchTools,
  languages,
} from '../data/activities';

const toTimeline = (items: typeof teaching) =>
  items.map((e) => ({ period: e.period, title: e.role, subtitle: e.organisation, description: e.description }));

const index = [
  { id: 'teaching', letter: 'A', label: 'Teaching Experience' },
  { id: 'research-experience', letter: 'B', label: 'Research & Professional Experience' },
  { id: 'conferences', letter: 'C', label: 'Conference Presentations' },
  { id: 'workshops', letter: 'D', label: 'Workshops & Programmes' },
  { id: 'responsibilities', letter: 'E', label: 'Responsibilities & Leadership' },
  { id: 'awards', letter: 'F', label: 'Awards & Fellowships' },
  { id: 'certificates', letter: 'G', label: 'Certificate Courses' },
  { id: 'skills', letter: 'H', label: 'Research Tools & Skills' },
  { id: 'languages', letter: 'I', label: 'Languages' },
];
---

<BaseLayout
  title="Academic Activities"
  description="Teaching, research experience, conference presentations, workshops, responsibilities, awards, certificate courses, skills and languages of Anand Raj."
>
  <PageHeader
    eyebrow="Academic Activities"
    title="Teaching, presentations and service"
    lead="A chronological record of teaching, research positions, conferences, workshops, academic responsibilities and recognition."
  />

  <div class="container page-grid">
    <SectionIndex items={index} />

    <div>
      <Section id="teaching" letter="A" title="Teaching Experience">
        <Timeline items={toTimeline(teaching)} />
      </Section>

      <Section id="research-experience" letter="B" title="Research and Professional Experience" count={researchExperience.length}>
        <Timeline items={toTimeline(researchExperience)} />
      </Section>

      <Section id="conferences" letter="C" title="Conference Paper Presentations" count={conferences.length}>
        <DatedList items={conferences} />
      </Section>

      <Section id="workshops" letter="D" title="Workshops and Academic Programmes" count={workshops.length}>
        <DatedList items={workshops} />
      </Section>

      <Section id="responsibilities" letter="E" title="Academic Responsibilities and Leadership" count={responsibilities.length}>
        <DatedList items={responsibilities} />
      </Section>

      <Section id="awards" letter="F" title="Awards and Fellowships" count={awards.length}>
        <DatedList items={awards} />
      </Section>

      <Section id="certificates" letter="G" title="Certificate Courses" count={certificates.length}>
        <DatedList items={certificates} />
      </Section>

      <Section id="skills" letter="H" title="Research Tools and Skills">
        <ul class="skill-grid">
          {researchTools.map((tool) => (
            <li>
              <span class="s-name">{tool.name}</span>
              <span class="s-use">{tool.use}</span>
            </li>
          ))}
        </ul>
        <p class="methods">
          <span>Research methods:</span> archival research and historiography · qualitative research methodology ·
          field surveys · data analysis and visualisation · mixed methods · research ethics (CITI Program)
        </p>
      </Section>

      <Section id="languages" letter="I" title="Languages">
        <ul class="lang-list">
          {languages.map((l) => (
            <li>
              <span class="s-name">{l.name}</span>
              <span class="s-use">{l.level}</span>
            </li>
          ))}
        </ul>
        <p class="next">
          <a class="text-link" href="/contact">Get in touch <span aria-hidden="true">→</span></a>
        </p>
      </Section>
    </div>
  </div>
</BaseLayout>

<style>
  .skill-grid,
  .lang-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(12rem, 1fr));
    gap: 0.75rem;
  }

  .skill-grid li,
  .lang-list li {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--rule);
    background: var(--surface);
    border-radius: var(--radius);
    padding: 0.75rem 1rem;
  }

  .s-name {
    font-family: var(--serif);
    font-size: 1.08rem;
    font-weight: 600;
    color: var(--ink);
  }

  .s-use {
    font-size: 0.875rem;
    color: var(--muted);
  }

  .methods {
    margin: 1.25rem 0 0;
    font-size: 0.95rem;
    color: var(--ink-2);
  }

  .methods span {
    font-weight: 600;
    color: var(--ink);
  }

  .next {
    margin-top: 2.5rem;
  }
</style>
