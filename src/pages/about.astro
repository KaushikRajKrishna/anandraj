---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import SectionIndex from '../components/SectionIndex.astro';
import Timeline from '../components/Timeline.astro';
import { biography, professionalProfile, profile } from '../data/profile';
import { education } from '../data/education';
import { workExperience } from '../data/experience';

const educationTimeline = education.map((e) => ({
  period: e.period,
  title: e.degree,
  subtitle: [e.institution, e.place].filter(Boolean).join(', '),
  detail: e.detail,
}));

// Work experience: positions held only (study milestones live under Education).
const work = workExperience.map((w) => ({
  period: w.period,
  title: w.role,
  subtitle: w.organisation,
  detail: w.detail,
  description: w.description,
}));

const index = [
  { id: 'biography', label: 'Biography' },
  { id: 'education', label: 'Education' },
  { id: 'work', label: 'Work Experience' },
  { id: 'profile', label: 'Professional Profile' },
];
---

<BaseLayout
  title="About"
  description="Biography, education and work experience of Anand Raj, PhD Scholar in the Department of Liberal Arts, IIT Hyderabad."
>
  <PageHeader
    eyebrow="About"
    title="Biography and work experience"
    lead={`${profile.designation}, ${profile.department}, ${profile.institution}.`}
  />

  <div class="container page-grid">
    <SectionIndex items={index} />

    <div>
      <Section id="biography" title="Biography">
        <div class="prose bio">
          {biography.map((p) => <p>{p}</p>)}
        </div>
      </Section>

      <Section id="education" title="Education">
        <Timeline items={educationTimeline} />
      </Section>

      <Section
        id="work"
        title="Work Experience"
        intro="Positions in teaching, research and labour advocacy, most recent first."
      >
        <Timeline items={work} />
      </Section>

      <Section id="profile" title="Professional Profile">
        <dl class="profile-table">
          {professionalProfile.map((row) => (
            <div>
              <dt>{row.label}</dt>
              <dd>{row.value}</dd>
            </div>
          ))}
        </dl>
      </Section>
    </div>
  </div>
</BaseLayout>

<style>
  .bio p:first-child::first-letter {
    font-family: var(--serif);
    float: left;
    font-size: 3.4rem;
    line-height: 0.9;
    padding: 0.3rem 0.5rem 0 0;
    color: var(--accent-strong);
  }

  .prose strong {
    color: var(--ink);
    font-weight: 600;
  }

  .bg-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  @media (min-width: 720px) {
    .bg-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .bg-grid > div {
    border-top: 2px solid var(--accent);
    background: var(--surface);
    padding: 1rem 1.1rem;
  }

  .bg-grid h3 {
    font-size: 1rem;
    margin-bottom: 0.35rem;
  }

  .bg-grid p {
    margin: 0;
    font-size: 0.92rem;
  }

  .profile-table {
    margin: 0;
  }

  .profile-table > div {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.1rem;
    padding-block: 0.75rem;
    border-bottom: 1px solid var(--rule);
  }

  @media (min-width: 640px) {
    .profile-table > div {
      grid-template-columns: 11rem minmax(0, 1fr);
      gap: 1.5rem;
    }
  }

  .profile-table dt {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
    padding-top: 0.15rem;
  }

  .profile-table dd {
    margin: 0;
    color: var(--ink);
  }

</style>
