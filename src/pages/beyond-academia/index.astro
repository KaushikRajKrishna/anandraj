---
// Overview: the three sections side by side, each with a preview of its first pictures.
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import { gallerySections, beyondIntro, type GalleryItem } from '../../data/beyondAcademia';

const preview = (items: GalleryItem[]) =>
  items
    .map((i) => (i.type === 'image' ? i.src : i.type === 'link' ? i.image : i.poster))
    .filter((s): s is string => Boolean(s))
    .slice(0, 3);

const countLabel = (n: number) => (n === 0 ? 'Coming soon' : `${n} ${n === 1 ? 'item' : 'items'}`);
---

<BaseLayout
  title="Beyond Academia"
  description="Sketching, photography and documentary work by Anand Raj, beyond academia."
>
  <PageHeader eyebrow="Beyond Academia" title="Beyond Academia" lead={beyondIntro} />

  <div class="container wrap">
    <ul class="cols" role="list">
      {gallerySections.map((s) => {
        const pics = preview(s.items);
        return (
          <li>
            <a class="col" href={`/beyond-academia/${s.slug}`}>
              <span class="stack" aria-hidden="true">
                {pics.length > 0 ? (
                  pics.map((src, i) => <img src={src} alt="" loading="lazy" decoding="async" style={`--i:${i}`} />)
                ) : (
                  <span class="placeholder">{s.letter}</span>
                )}
              </span>
              <span class="body">
                <span class="letter">{s.letter}</span>
                <span class="t">{s.label}</span>
                <span class="d">{s.description}</span>
                <span class="meta">
                  {countLabel(s.items.length)}
                  <span class="arrow" aria-hidden="true">→</span>
                </span>
              </span>
            </a>
          </li>
        );
      })}
    </ul>
  </div>
</BaseLayout>

<style>
  .wrap {
    padding-bottom: 5rem;
  }

  .cols {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: clamp(1.25rem, 3vw, 2rem);
  }

  .col {
    display: flex;
    flex-direction: column;
    height: 100%;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--surface);
    color: inherit;
    text-decoration: none;
    overflow: hidden;
    transition: transform 0.25s ease, box-shadow 0.25s ease, border-color 0.25s ease;
  }

  .col:hover,
  .col:focus-visible {
    transform: translateY(-3px);
    border-color: var(--rule-strong);
    box-shadow: 0 1px 2px rgb(21 35 61 / 0.06), 0 18px 34px -18px rgb(21 35 61 / 0.4);
  }

  .col:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  /* Three pictures fanned like a small pile of prints */
  .stack {
    position: relative;
    display: block;
    height: 15rem;
    background:
      radial-gradient(circle at 1px 1px, rgb(21 35 61 / 0.07) 1px, transparent 0) 0 0 / 14px 14px,
      #f3f1ec;
    border-bottom: 1px solid var(--rule);
    overflow: hidden;
  }

  .stack img {
    position: absolute;
    top: 1.4rem;
    left: 50%;
    width: 9rem;
    height: 11.25rem;
    object-fit: cover;
    object-position: top;
    border: 4px solid #fff;
    border-radius: 2px;
    box-shadow: 0 8px 20px -10px rgb(21 35 61 / 0.5);
    transform: translateX(calc(-50% + (var(--i) - 1) * 4.6rem)) rotate(calc((var(--i) - 1) * 6deg));
    transition: transform 0.3s ease;
  }

  .stack img:nth-child(2) {
    z-index: 2;
    top: 1rem;
  }

  .col:hover .stack img {
    transform: translateX(calc(-50% + (var(--i) - 1) * 5.2rem)) rotate(calc((var(--i) - 1) * 8deg));
  }

  .placeholder {
    display: grid;
    place-items: center;
    height: 100%;
    font-family: var(--serif);
    font-size: 4rem;
    color: var(--rule-strong);
  }

  .body {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.25rem 1.35rem 1.35rem;
    flex: 1;
  }

  .letter {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    color: var(--accent);
  }

  .t {
    font-family: var(--serif);
    font-size: 1.45rem;
    color: var(--ink);
  }

  .d {
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  .meta {
    margin-top: auto;
    padding-top: 0.9rem;
    display: flex;
    justify-content: space-between;
    font-size: 0.85rem;
    color: var(--accent-strong);
    font-weight: 500;
  }

  .arrow {
    transition: transform 0.2s ease;
  }

  .col:hover .arrow {
    transform: translateX(4px);
  }

  @media (prefers-reduced-motion: reduce) {
    .col,
    .stack img,
    .arrow {
      transition: none;
    }
  }
</style>
