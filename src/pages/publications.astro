---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Bibliography from '../components/Bibliography.astro';
import { academicSections } from '../data/publications';

const total = academicSections.reduce((n, s) => n + s.items.length, 0);
---

<BaseLayout
  title="Academic Publications"
  description="Journal articles, book reviews, book chapters, books and research reports by Anand Raj."
>
  <PageHeader
    eyebrow="My Writings · Academic Publications"
    title="Academic Publications"
    lead={`Journal articles, book reviews, book chapters, books and research reports, in reverse chronological order within each section (${total} entries).`}
  />

  <Bibliography sections={academicSections} />
</BaseLayout>
