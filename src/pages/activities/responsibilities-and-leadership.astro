---
import SubPage from '../../components/SubPage.astro';
import Section from '../../components/Section.astro';
import DatedList from '../../components/DatedList.astro';
import { responsibilities } from '../../data/activities';

const leadership = responsibilities.filter((item) => item.id !== 'mentor');
const index = [{ id: 'responsibilities', letter: 'A', label: 'Responsibilities and Leadership' }];
---

<SubPage
  title="Responsibilities and Leadership"
  eyebrow="Academic Engagements · Responsibilities and Leadership"
  lead="Institutional responsibilities and leadership roles at IIT Hyderabad."
  description="Academic responsibilities and leadership roles of Anand Raj at IIT Hyderabad."
  group="/activities"
  index={index}
>
  <Section id="responsibilities" title="Responsibilities and Leadership" count={leadership.length}>
    <DatedList items={leadership} />
  </Section>
</SubPage>
