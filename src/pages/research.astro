---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Section from '../components/Section.astro';
import SectionIndex from '../components/SectionIndex.astro';
import Timeline from '../components/Timeline.astro';
import { researchOverview, researchAreas, tgpwuEngagement, projects } from '../data/research';
import { researchExperience } from '../data/experience';

const index = [
  { id: 'overview', label: 'Research Overview' },
  { id: 'interests', label: 'Research Interests' },
  { id: 'tgpwu', label: 'TGPWU Engagement' },
  { id: 'experience', label: 'Research Experience' },
  { id: 'projects', label: 'Research Projects' },
];

const experienceTimeline = researchExperience.map((e) => ({
  period: e.period,
  title: e.role,
  subtitle: e.organisation,
  description: e.description,
}));
---

<BaseLayout
  title="Research"
  description="Research interests of Anand Raj: labour studies, migration and mobility, gig and platform economy, urban studies, political economy, and development and social inequality."
>
  <PageHeader
    eyebrow="Research"
    title="Labour, migration and the city"
    lead="Research interests, field engagement, research experience and projects."
  />

  <div class="container page-grid">
    <SectionIndex items={index} />

    <div>
      <Section id="overview" title="Research Overview">
        <div class="prose">
          {researchOverview.map((p) => <p>{p}</p>)}
        </div>
      </Section>

      <Section id="interests" title="Research Interests" intro="Six connected areas of inquiry, each with related work from my research, teaching and writing.">
        <div class="areas">
          {researchAreas.map((area, i) => (
            <article class="area" id={area.id} aria-labelledby={`${area.id}-h`}>
              <p class="num">{String(i + 1).padStart(2, '0')}</p>
              <div>
                <h3 id={`${area.id}-h`}>{area.title}</h3>
                <p>{area.description}</p>
                <ul class="related" aria-label={`Related work in ${area.title}`}>
                  {area.related.map((r) => <li>{r}</li>)}
                </ul>
              </div>
            </article>
          ))}
        </div>
      </Section>

      <Section id="tgpwu" title="Telangana Gig and Platform Workers Union">
        <div class="engagement">
          <div class="eng-meta">
            <p><span>Role</span>{tgpwuEngagement.role}</p>
            <p><span>Period</span>{tgpwuEngagement.period}</p>
            <p><span>Location</span>Hyderabad, India</p>
          </div>
          <div class="prose">
            {tgpwuEngagement.paragraphs.map((p) => <p>{p}</p>)}
          </div>
        </div>
      </Section>

      <Section id="experience" title="Research Experience">
        <Timeline items={experienceTimeline} />
      </Section>

      <Section id="projects" title="Research Projects">
        <ol class="projects">
          {projects.map((p) => (
            <li>
              <p class="p-period">{p.period}</p>
              <h3>{p.title}</h3>
              <p class="p-meta">{p.institution} · {p.role}</p>
              <p class="p-desc">{p.description}</p>
            </li>
          ))}
        </ol>
        <p class="next">
          <a class="text-link" href="/publications">Continue to Academic Publications <span aria-hidden="true">→</span></a>
        </p>
      </Section>
    </div>
  </div>
</BaseLayout>

<style>
  .areas {
    display: grid;
    gap: 0;
  }

  .area {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 1rem;
    padding-block: 1.4rem;
    border-bottom: 1px solid var(--rule);
    scroll-margin-top: calc(var(--header-h) + 1.5rem);
  }

  .area:first-child {
    padding-top: 0.25rem;
  }

  .area:last-child {
    border-bottom: 0;
  }

  .num {
    font-family: var(--serif);
    font-size: 1.25rem;
    color: var(--accent);
    margin: 0;
    line-height: 1.4;
  }

  .area h3 {
    font-size: 1.25rem;
    margin-bottom: 0.4rem;
  }

  .area p {
    margin: 0;
    max-width: var(--prose);
  }

  .related {
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.9rem;
    color: var(--muted);
  }

  .related li {
    position: relative;
    padding-left: 1rem;
  }

  .related li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 0.45rem;
    height: 1px;
    background: var(--accent);
  }

  .engagement {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.25rem 2.5rem;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-left: 3px solid var(--accent);
    padding: clamp(1.25rem, 3vw, 1.75rem);
  }

  @media (min-width: 760px) {
    .engagement {
      grid-template-columns: 13rem minmax(0, 1fr);
    }
  }

  .eng-meta p {
    margin: 0 0 0.75rem;
    color: var(--ink);
    font-size: 0.95rem;
  }

  .eng-meta span {
    display: block;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .engagement .prose p:last-child {
    margin-bottom: 0;
  }

  .projects {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .projects li {
    padding-block: 1.1rem;
    border-bottom: 1px solid var(--rule);
  }

  .projects li:first-child {
    padding-top: 0.25rem;
  }

  .p-period {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 0.2rem;
  }

  .projects h3 {
    font-size: 1.12rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .p-meta {
    margin: 0.25rem 0 0;
    color: var(--muted);
    font-size: 0.92rem;
  }

  .p-desc {
    margin: 0.4rem 0 0;
    font-size: 0.97rem;
    max-width: var(--prose);
  }

  .next {
    margin-top: 2rem;
  }
</style>
