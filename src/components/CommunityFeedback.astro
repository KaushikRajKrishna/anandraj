---
// "Community Building": feedback cards, each drawn as a different kind of paper note
// (letter, ruled index card, postcard with stamp, pinned note, ink card).
import { feedback, communityIntro, feedbackInvite, type FeedbackStyle } from '../data/community';
import { profile } from '../data/profile';

const rotation: FeedbackStyle[] = ['letter', 'pinned', 'postcard', 'index', 'ink'];
const initials = (name: string) =>
  name
    .split(/\s+/)
    .filter((w) => /^[A-Z]/.test(w))
    .slice(0, 2)
    .map((w) => w[0])
    .join('') || name.slice(0, 2).toUpperCase();

const cards = feedback.map((f, i) => ({ ...f, style: f.style ?? rotation[i % rotation.length], initials: initials(f.name) }));
const mailto = `mailto:${profile.email}?subject=${encodeURIComponent(feedbackInvite.subject)}`;
---

{cards.length > 0 && (
  <section class="community" aria-labelledby="h-community">
    <div class="container">
      <div class="head">
        <div>
          <p class="eyebrow">Community</p>
          <h2 id="h-community">Community Building</h2>
          <p class="intro">{communityIntro}</p>
        </div>
        <div class="controls">
          <button type="button" class="nav-btn" data-dir="-1" aria-label="Scroll feedback left" aria-controls="community-track">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" /></svg>
          </button>
          <button type="button" class="nav-btn" data-dir="1" aria-label="Scroll feedback right" aria-controls="community-track">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" /></svg>
          </button>
        </div>
      </div>

      <div class="wall" id="community-track" tabindex="0" role="region" aria-label="Feedback cards, scroll horizontally">
        {cards.map((c, i) => (
          <article class:list={['fb', `fb--${c.style}`]} style={`--i:${i}`}>
            {c.style === 'pinned' && <span class="tape" aria-hidden="true"></span>}
            {c.style === 'postcard' && (
              <span class="stamp" aria-hidden="true">
                <span>{c.initials}</span>
              </span>
            )}

            <header class="who">
              {c.style !== 'postcard' && <span class="avatar" aria-hidden="true">{c.initials}</span>}
              <div>
                <h3 class="name">{c.name}</h3>
                <p class="role">{c.designation}</p>
              </div>
            </header>

            <blockquote class="quote">
              <p>{c.text}</p>
            </blockquote>

            {(c.context || c.date || c.sample) && (
              <footer class="meta">
                {c.context && <span>{c.context}</span>}
                {c.date && <span>{c.date}</span>}
                {c.sample && <span class="sample">Sample</span>}
              </footer>
            )}
          </article>
        ))}
      </div>

      <p class="invite">
        {feedbackInvite.text}{' '}<a href={mailto}>Share your feedback <span aria-hidden="true">→</span></a>
      </p>
    </div>
  </section>
)}

<script>
  // Arrow buttons scroll the single-row track by roughly one card; they disable at either end.
  function initCommunity() {
    const track = document.getElementById('community-track');
    if (!track) return;
    const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.community .nav-btn'));
    const step = () => {
      const card = track.querySelector<HTMLElement>('.fb');
      return card ? card.offsetWidth + 28 : track.clientWidth * 0.8;
    };
    const update = () => {
      const max = track.scrollWidth - track.clientWidth - 2;
      buttons.forEach((b) => {
        const dir = Number(b.dataset.dir);
        b.disabled = dir < 0 ? track.scrollLeft <= 2 : track.scrollLeft >= max;
      });
    };
    buttons.forEach((b) =>
      b.addEventListener('click', () => track.scrollBy({ left: Number(b.dataset.dir) * step(), behavior: 'smooth' }))
    );
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight' || e.key === 'ArrowLeft') {
        e.preventDefault();
        track.scrollBy({ left: (e.key === 'ArrowRight' ? 1 : -1) * step(), behavior: 'smooth' });
      }
    });
    update();
  }
  document.addEventListener('astro:page-load', initCommunity);
</script>

<style>
  .community {
    padding-block: clamp(3.5rem, 7vw, 5.5rem);
    background:
      radial-gradient(circle at 1px 1px, rgb(21 35 61 / 0.07) 1px, transparent 0) 0 0 / 22px 22px,
      var(--bg);
    border-top: 1px solid var(--rule);
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    margin-bottom: clamp(1.25rem, 3vw, 2rem);
  }

  .controls {
    display: flex;
    gap: 0.6rem;
  }

  .nav-btn {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    border: 1px solid var(--ink);
    background: var(--ink);
    color: #fff;
    cursor: pointer;
    transition: background 0.2s ease, color 0.2s ease, opacity 0.2s ease, transform 0.2s ease;
  }

  .nav-btn svg {
    width: 1.1rem;
    height: 1.1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .nav-btn:hover:not(:disabled) {
    background: var(--accent-strong);
    border-color: var(--accent-strong);
    transform: translateY(-1px);
  }

  .nav-btn:disabled {
    background: transparent;
    color: var(--muted);
    border-color: var(--rule-strong);
    opacity: 0.6;
    cursor: default;
  }

  h2 {
    font-size: clamp(1.6rem, 3.6vw, 2.2rem);
    font-weight: 500;
  }

  .intro {
    margin: 0.75rem 0 0;
    max-width: 40rem;
    color: var(--muted);
  }

  /* Single row, scrolls horizontally: 3 cards per view on laptops, 2 on tablets, 1 on phones */
  @media (min-width: 680px) {
    .wall > .fb {
      flex-basis: calc((100% - 1.75rem) / 2);
    }
  }

  @media (min-width: 1040px) {
    .wall > .fb {
      flex-basis: calc((100% - 2 * 1.75rem) / 3);
    }
  }

  .wall {
    display: flex;
    align-items: flex-start;
    gap: 1.75rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: 0.25rem;
    /* room for tilted cards, tape and shadows */
    padding: 1.4rem 0.4rem 1.6rem;
    margin-inline: -0.4rem;
    scrollbar-width: thin;
    scrollbar-color: var(--rule-strong) transparent;
  }

  .wall:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
  }

  .wall::-webkit-scrollbar {
    height: 6px;
  }

  .wall::-webkit-scrollbar-thumb {
    background: var(--rule-strong);
    border-radius: 999px;
  }

  .fb {
    --tilt: 0deg;
    position: relative;
    flex: 0 0 86%;
    scroll-snap-align: start;
    margin: 0;
    padding: 1.5rem 1.5rem 1.25rem;
    border-radius: 6px;
    background: var(--surface);
    color: var(--ink-2);
    box-shadow:
      0 1px 2px rgb(21 35 61 / 0.06),
      0 10px 24px -14px rgb(21 35 61 / 0.25);
    transform: rotate(var(--tilt));
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  @media (min-width: 680px) {
    .fb:hover {
      transform: rotate(0deg) translateY(-3px);
      box-shadow:
        0 1px 2px rgb(21 35 61 / 0.06),
        0 18px 34px -16px rgb(21 35 61 / 0.35);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .fb,
    .fb:hover {
      transition: none;
      transform: none;
    }
  }

  /* --- Shared parts --- */
  .who {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-bottom: 1rem;
  }

  .avatar {
    flex: none;
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    background: var(--accent-soft);
    color: var(--accent-strong);
    font-family: var(--serif);
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: 0.03em;
  }

  .name {
    font-family: var(--serif);
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--ink);
    line-height: 1.25;
  }

  .role {
    margin: 0.1rem 0 0;
    font-size: 0.82rem;
    color: var(--muted);
    line-height: 1.4;
  }

  .quote {
    margin: 0;
  }

  .quote p {
    margin: 0;
    font-family: var(--serif);
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--ink);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.9rem;
    margin-top: 1.1rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .sample {
    color: #9a5b13;
    background: #fbefd9;
    border-radius: 3px;
    padding: 0.05rem 0.4rem;
  }

  /* --- 1. Letter: oversized quotation mark, signed-off feel --- */
  .fb--letter {
    --tilt: -0.6deg;
    border: 1px solid var(--rule);
    padding-top: 2.6rem;
  }

  .fb--letter::before {
    content: '“';
    position: absolute;
    top: -0.35rem;
    left: 1.1rem;
    font-family: var(--serif);
    font-size: 5.5rem;
    line-height: 1;
    color: var(--accent);
    opacity: 0.25;
  }

  .fb--letter .quote p {
    font-style: italic;
  }

  /* --- 2. Pinned note: warm paper with a strip of tape --- */
  .fb--pinned {
    --tilt: 1deg;
    background: #fdf8ea;
    border-radius: 2px;
    padding-top: 1.9rem;
  }

  .tape {
    position: absolute;
    top: -0.7rem;
    left: 50%;
    width: 5.5rem;
    height: 1.5rem;
    transform: translateX(-50%) rotate(-3deg);
    background: rgb(196 210 228 / 0.75);
    box-shadow: 0 1px 2px rgb(21 35 61 / 0.12);
  }

  .fb--pinned .avatar {
    background: #f3e7c6;
    color: #7a5a17;
  }

  /* --- 3. Postcard: perforated stamp with initials, dashed divider --- */
  .fb--postcard {
    --tilt: -0.8deg;
    border: 1px solid var(--rule);
    background:
      linear-gradient(var(--surface), var(--surface)) padding-box,
      repeating-linear-gradient(45deg, #b8c6da 0 10px, var(--surface) 10px 16px, #e4c3bd 16px 26px, var(--surface) 26px 32px) border-box;
    border: 5px solid transparent;
    padding-right: 5.5rem;
  }

  .fb--postcard .who {
    border-bottom: 1px dashed var(--rule-strong);
    padding-bottom: 0.9rem;
  }

  .stamp {
    position: absolute;
    top: 1rem;
    right: 1rem;
    width: 3.4rem;
    height: 4rem;
    display: grid;
    place-items: center;
    background: var(--accent);
    color: #fff;
    font-family: var(--serif);
    font-weight: 600;
    font-size: 1.05rem;
    border: 4px dotted var(--surface);
    box-shadow: 0 0 0 1px var(--accent), 0 2px 6px -2px rgb(21 35 61 / 0.4);
    transform: rotate(4deg);
  }

  .stamp span {
    display: grid;
    place-items: center;
    width: 2.3rem;
    height: 2.9rem;
    border: 1px solid rgb(255 255 255 / 0.55);
  }

  .fb--postcard .quote {
    margin-right: -4rem;
  }

  /* --- 4. Index card: ruled lines and a margin rule --- */
  .fb--index {
    --tilt: 0.5deg;
    border-radius: 3px;
    padding-left: 2.4rem;
    background:
      linear-gradient(90deg, transparent 1.65rem, rgb(200 92 92 / 0.45) 1.65rem, rgb(200 92 92 / 0.45) calc(1.65rem + 1px), transparent calc(1.65rem + 1px)),
      var(--surface);
    border-top: 0.6rem solid #e9eef5;
  }

  /* Each line of text sits on its own ruled line */
  .fb--index .quote p {
    --lh: 1.7rem;
    line-height: var(--lh);
    font-size: 1rem;
    background: linear-gradient(to bottom, transparent calc(var(--lh) - 1px), rgb(62 95 134 / 0.2) calc(var(--lh) - 1px)) 0 0 / 100% var(--lh);
  }

  /* --- 5. Ink: deep navy card with light type --- */
  .fb--ink {
    --tilt: -0.4deg;
    background: var(--ink);
    color: #d9e0ec;
  }

  .fb--ink .name,
  .fb--ink .quote p {
    color: #fff;
  }

  .fb--ink .role {
    color: #a9bdd6;
  }

  .fb--ink .avatar {
    background: rgb(255 255 255 / 0.12);
    color: #fff;
  }

  .fb--ink .meta {
    color: #a9bdd6;
  }

  .fb--ink::after {
    content: '';
    position: absolute;
    inset: 0.5rem;
    border: 1px solid rgb(255 255 255 / 0.12);
    border-radius: 4px;
    pointer-events: none;
  }

  /* No tilts on phones */
  @media (max-width: 679px) {
    .fb {
      --tilt: 0deg;
    }
  }

  .invite {
    margin: 1rem 0 0;
    color: var(--ink-2);
  }

  .invite a {
    font-weight: 500;
    white-space: nowrap;
  }
</style>
