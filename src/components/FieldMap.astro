---
// Schematic place plot using real latitude and longitude, without country outlines.
import type { Place } from '../data/home';
interface Props {
  places: Place[];
}
const { places } = Astro.props;

const W = 500;
const H = 300;
const minLon = Math.min(...places.map((p) => p.lon));
const maxLon = Math.max(...places.map((p) => p.lon));
const minLat = Math.min(...places.map((p) => p.lat));
const maxLat = Math.max(...places.map((p) => p.lat));
const x = (lon: number) => 25 + ((lon - minLon) / (maxLon - minLon || 1)) * 350;
const y = (lat: number) => 32 + ((maxLat - lat) / (maxLat - minLat || 1)) * 236;

const pts = places.map((p) => ({ ...p, cx: x(p.lon), cy: y(p.lat) }));

// Background dot grid for a cartographic feel
const grid: { cx: number; cy: number }[] = [];
for (let gx = 10; gx < W; gx += 14) for (let gy = 10; gy < H; gy += 14) grid.push({ cx: gx, cy: gy });
---

<figure class="field-map">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="map-title map-desc">
    <title id="map-title">Places I have lived, worked and done fieldwork</title>
    <desc id="map-desc">{places.map((p) => p.name).join(', ')}, positioned by latitude and longitude.</desc>
    <g class="grid">
      {grid.map((d) => <circle cx={d.cx} cy={d.cy} r="0.9" />)}
    </g>
    {pts.map((p) => (
      <g class="pt">
        <circle class="halo" cx={p.cx} cy={p.cy} r="9" />
        <circle class="dot" cx={p.cx} cy={p.cy} r="4.5" />
        <text
          class="lbl"
          x={p.labelSide === 'left' ? p.cx - 13 : p.cx + 13}
          y={p.cy + 4 + (p.labelDy ?? 0)}
          text-anchor={p.labelSide === 'left' ? 'end' : 'start'}
        >
          {p.name}
        </text>
      </g>
    ))}
  </svg>
  <figcaption>Approximate city locations, plotted by latitude and longitude.</figcaption>
</figure>

<style>
  .field-map {
    margin: 0;
  }

  svg {
    width: 100%;
    max-width: 600px;
    height: auto;
    display: block;
    margin-inline: auto;
  }

  .grid circle {
    fill: var(--rule-strong);
    opacity: 0.8;
  }

  .halo {
    fill: var(--accent-soft);
  }

  .dot {
    fill: var(--ink);
    stroke: var(--bg);
    stroke-width: 1.5;
  }

  .lbl {
    font-family: var(--serif);
    font-size: 13px;
    fill: var(--ink);
    font-weight: 600;
  }

  figcaption {
    margin-top: 0.75rem;
    font-size: 0.8rem;
    color: var(--muted);
    text-align: center;
    max-width: 30rem;
    margin-inline: auto;
  }
</style>
