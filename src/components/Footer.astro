---
import { navigation } from '../data/navigation';
import { profile } from '../data/profile';
import Icon from './Icon.astro';
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container grid">
    <div>
      <p class="f-name">{profile.name}</p>
      <p class="f-line">
        {profile.designation}, {profile.department}<br />
        {profile.institution}
      </p>
    </div>
    <nav aria-label="Footer">
      <ul>
        {navigation.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
        <li><a href={profile.cv} download="Anand-Raj-CV.pdf" data-astro-reload>Download CV</a></li>
      </ul>
    </nav>
    <div class="f-contact">
      <a href={`mailto:${profile.email}`}>{profile.email}</a>
      <a class="f-linkedin" href={profile.linkedin} target="_blank" rel="noopener noreferrer">
        <Icon name="linkedin" /> LinkedIn
      </a>
      <span>{profile.location}</span>
    </div>
  </div>
  <div class="container base">
    <p>© {year} {profile.name}. All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 2rem;
    border-top: 1px solid var(--rule);
    background: var(--surface-2);
    font-size: 0.9rem;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
    padding-block: 2.75rem 2rem;
  }

  @media (min-width: 800px) {
    .grid {
      grid-template-columns: 1.3fr 1.6fr 1fr;
      gap: 3rem;
    }
  }

  .f-name {
    font-family: var(--serif);
    font-size: 1.2rem;
    font-weight: 600;
    color: var(--ink);
    margin-bottom: 0.4rem;
  }

  .f-line {
    color: var(--muted);
    line-height: 1.6;
    margin: 0;
  }

  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.4rem 1.5rem;
  }

  a {
    color: var(--ink-2);
    text-decoration: none;
  }

  a:hover {
    color: var(--accent);
    text-decoration: underline;
  }

  .f-contact {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    color: var(--muted);
    overflow-wrap: anywhere;
  }

  .f-linkedin {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .f-linkedin :global(svg) {
    width: 1rem;
    height: 1rem;
    color: var(--accent);
  }

  .base {
    border-top: 1px solid var(--rule);
    padding-block: 1.1rem;
    color: var(--muted);
    font-size: 0.8rem;
  }

  .base p {
    margin: 0;
  }
</style>
