---
import { navigation } from '../data/navigation';
import { profile } from '../data/profile';
import Icon from './Icon.astro';

const normalise = (p: string) => (p.length > 1 ? p.replace(/\/+$/, '') : p);
const current = normalise(Astro.url.pathname);
const isActive = (href: string) => normalise(href) === current;
const inGroup = (hrefs: string[]) => hrefs.map(normalise).includes(current);
---

<header class="site-header" transition:persist="site-header">
  <div class="container bar">
    <a class="brand" href="/" aria-label={`${profile.name}, home`}>
      <span class="brand-name">{profile.name}</span>
      <span class="brand-sub">{profile.designation} · {profile.institutionShort}</span>
    </a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="visually-hidden">Menu</span>
      <span class="bars" aria-hidden="true"><span></span><span></span><span></span></span>
    </button>

    <nav id="site-nav" class="nav" aria-label="Main">
      <ul>
        {navigation.map((item) =>
          item.children ? (
            <li class="has-sub">
              <button
                type="button"
                class:list={['parent', { 'is-active': inGroup([item.href, ...item.children.map((c) => c.href)]) }]}
                aria-expanded="false"
                aria-controls={`sub-${normalise(item.href).replace(/\W/g, '') || 'menu'}`}
                data-group={[item.href, ...item.children.map((c) => c.href)].map(normalise).join(' ')}
              >
                {item.label}
                <svg class="chev" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5 6 7.5 9 4.5" /></svg>
              </button>
              <ul class="sub" id={`sub-${normalise(item.href).replace(/\W/g, '') || 'menu'}`} aria-label={item.label}>
                {item.children.map((child) => (
                  <li>
                    <a href={child.href} data-nav={normalise(child.href)} aria-current={isActive(child.href) ? 'page' : undefined}>
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            </li>
          ) : (
            <li>
              <a href={item.href} data-nav={normalise(item.href)} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          )
        )}
      </ul>
      <a class="btn cv-btn" href={profile.cv} download="Anand-Raj-CV.pdf" data-astro-reload>
        <Icon name="download" /> Download CV
      </a>
    </nav>
  </div>
</header>

<script>
  // The header persists across page swaps, so the active state is refreshed on every navigation.
  function setup() {
    const header = document.querySelector<HTMLElement>('.site-header');
    if (!header) return;
    const toggle = header.querySelector<HTMLButtonElement>('.menu-toggle');
    const norm = (p: string) => (p.length > 1 ? p.replace(/\/+$/, '') : p);
    const path = norm(location.pathname);

    header.querySelectorAll<HTMLAnchorElement>('[data-nav]').forEach((a) => {
      if (a.dataset.nav === path) a.setAttribute('aria-current', 'page');
      else a.removeAttribute('aria-current');
    });
    // Highlight a dropdown parent when one of its pages is open.
    header.querySelectorAll<HTMLButtonElement>('[data-group]').forEach((b) => {
      b.classList.toggle('is-active', (b.dataset.group ?? '').split(' ').includes(path));
    });

    // Dropdowns: the parent is a button that only opens/closes its menu (never navigates).
    const closeAll = (except?: Element) => {
      header.querySelectorAll<HTMLElement>('.has-sub.is-expanded').forEach((li) => {
        if (li === except) return;
        li.classList.remove('is-expanded');
        li.querySelector('.parent')?.setAttribute('aria-expanded', 'false');
      });
    };
    closeAll();
    const focused = document.activeElement;
    if (focused instanceof HTMLElement && focused.closest('.has-sub')) focused.blur();

    if (!header.dataset.subBound) {
      header.dataset.subBound = '1';
      header.querySelectorAll<HTMLButtonElement>('.has-sub > .parent').forEach((btn) => {
        btn.addEventListener('click', () => {
          const li = btn.parentElement!;
          closeAll(li);
          const open = li.classList.toggle('is-expanded');
          btn.setAttribute('aria-expanded', String(open));
        });
      });
      document.addEventListener('click', (e) => {
        if (!(e.target as Element).closest('.has-sub')) closeAll();
      });
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        const openLi = header.querySelector('.has-sub.is-expanded');
        if (openLi) {
          closeAll();
          openLi.querySelector<HTMLButtonElement>('.parent')?.focus();
        }
      });
    }

    // Close the mobile menu after navigating.
    header.classList.remove('is-open');
    toggle?.setAttribute('aria-expanded', 'false');

    if (toggle && !toggle.dataset.bound) {
      toggle.dataset.bound = '1';
      toggle.addEventListener('click', () => {
        const open = header.classList.toggle('is-open');
        toggle.setAttribute('aria-expanded', String(open));
      });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && header.classList.contains('is-open')) {
          header.classList.remove('is-open');
          toggle.setAttribute('aria-expanded', 'false');
          toggle.focus();
        }
      });
    }

    const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 8);
    onScroll();
    if (!header.dataset.scrollBound) {
      header.dataset.scrollBound = '1';
      window.addEventListener('scroll', onScroll, { passive: true });
    }
  }
  document.addEventListener('astro:page-load', setup);
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: saturate(140%) blur(8px);
    -webkit-backdrop-filter: saturate(140%) blur(8px);
    border-bottom: 1px solid transparent;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }

  .site-header.is-scrolled {
    border-bottom-color: var(--rule);
  }

  .bar {
    min-height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .brand {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    line-height: 1.15;
    min-width: 0;
  }

  .brand-name {
    font-family: var(--serif);
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--ink);
    letter-spacing: -0.01em;
  }

  .brand-sub {
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin-top: 0.2rem;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 1.25rem;
  }

  .nav ul {
    display: flex;
    gap: 0.15rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav ul a {
    position: relative;
    display: block;
    padding: 0.5rem 0.6rem;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--ink-2);
    text-decoration: none;
    white-space: nowrap;
  }

  .nav ul a::after {
    content: '';
    position: absolute;
    left: 0.6rem;
    right: 0.6rem;
    bottom: 0.2rem;
    height: 1.5px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s ease;
  }

  .nav ul a:hover {
    color: var(--ink);
  }

  .nav ul a:hover::after {
    transform: scaleX(1);
    opacity: 0.4;
  }

  .nav ul a[aria-current='page'] {
    color: var(--ink);
  }

  .nav ul a[aria-current='page']::after,
  .parent.is-active::after {
    transform: scaleX(1);
    opacity: 1;
  }

  /* ---- Dropdown ("My Publications") ---- */
  .has-sub {
    position: relative;
  }

  /* Parent is a <button> styled like the other menu links */
  .parent {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.5rem 0.6rem;
    border: 0;
    background: none;
    font: inherit;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--ink-2);
    white-space: nowrap;
    cursor: pointer;
  }

  .parent::after {
    content: '';
    position: absolute;
    left: 0.6rem;
    right: 0.6rem;
    bottom: 0.2rem;
    height: 1.5px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.2s ease;
  }

  .parent:hover,
  .parent.is-active,
  .has-sub.is-expanded > .parent {
    color: var(--ink);
  }

  .parent:hover::after {
    transform: scaleX(1);
    opacity: 0.4;
  }

  .chev {
    width: 0.7rem;
    height: 0.7rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: transform 0.2s ease;
  }

  .nav ul.sub {
    position: absolute;
    top: 100%;
    left: 0;
    z-index: 10;
    min-width: 15rem;
    flex-direction: column;
    gap: 0;
    padding: 0.4rem;
    background: var(--surface);
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    box-shadow: 0 14px 30px -14px rgb(21 35 61 / 0.28);
    opacity: 0;
    visibility: hidden;
    transform: translateY(6px);
    transition: opacity 0.18s ease, transform 0.18s ease, visibility 0.18s;
  }

  /* invisible bridge so the menu stays open while the pointer moves down */
  .nav ul.sub::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: -8px;
    height: 8px;
  }

  .has-sub:hover > ul.sub,
  .has-sub.is-expanded > ul.sub,
  .has-sub > ul.sub:focus-within {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .has-sub:hover .chev,
  .has-sub.is-expanded .chev {
    transform: rotate(180deg);
  }

  .nav ul.sub a {
    padding: 0.6rem 0.8rem;
    border-radius: 4px;
    font-size: 0.85rem;
    letter-spacing: 0.02em;
  }

  .nav ul.sub a::after {
    display: none;
  }

  .nav ul.sub a:hover {
    background: var(--accent-soft);
    color: var(--accent-strong);
  }

  .nav ul.sub a[aria-current='page'] {
    color: var(--accent-strong);
    font-weight: 600;
    box-shadow: inset 2px 0 0 var(--accent);
  }

  .cv-btn {
    padding: 0.45rem 0.9rem;
    font-size: 0.85rem;
  }

  .menu-toggle {
    display: none;
    width: 44px;
    height: 44px;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius);
    background: var(--surface);
    cursor: pointer;
    align-items: center;
    justify-content: center;
    flex: none;
  }

  .bars {
    display: grid;
    gap: 4px;
    width: 18px;
  }

  .bars span {
    display: block;
    height: 1.5px;
    background: var(--ink);
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  @media (max-width: 1080px) {
    .menu-toggle {
      display: inline-flex;
    }

    .nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 0.5rem var(--gutter) 1.25rem;
      background: var(--bg);
      border-bottom: 1px solid var(--rule);
      box-shadow: 0 12px 24px -16px rgb(21 35 61 / 0.25);
      display: none;
    }

    .site-header.is-open .nav {
      display: flex;
    }

    .nav ul {
      flex-direction: column;
      gap: 0;
    }

    .nav ul a {
      padding: 0.8rem 0;
      font-size: 1rem;
      border-bottom: 1px solid var(--rule);
    }

    .nav ul a::after {
      left: 0;
      right: auto;
      width: 3px;
      height: 1.2em;
      top: 50%;
      bottom: auto;
      transform: translate(-0.75rem, -50%) scaleY(0);
    }

    .nav ul a[aria-current='page'] {
      color: var(--accent-strong);
      font-weight: 600;
    }

    .nav ul a[aria-current='page']::after {
      transform: translate(-0.75rem, -50%) scaleY(1);
    }

    /* Dropdown becomes an indented group that expands on tap */
    .parent {
      display: flex;
      width: 100%;
      justify-content: space-between;
      padding: 0.8rem 0;
      font-size: 1rem;
      border-bottom: 1px solid var(--rule);
      text-align: left;
    }

    .parent::after {
      display: none;
    }

    .chev {
      width: 0.85rem;
      height: 0.85rem;
    }

    .has-sub:hover .chev {
      transform: none;
    }

    .has-sub.is-expanded .chev {
      transform: rotate(180deg);
    }

    .nav ul.sub {
      position: static;
      min-width: 0;
      padding: 0 0 0 1rem;
      background: none;
      border: 0;
      border-radius: 0;
      box-shadow: none;
      opacity: 1;
      visibility: visible;
      transform: none;
      display: none;
    }

    .has-sub.is-expanded > ul.sub {
      display: flex;
    }

    .nav ul.sub::before {
      display: none;
    }

    .nav ul.sub a {
      padding: 0.7rem 0;
      font-size: 0.95rem;
      border-radius: 0;
    }

    .nav ul.sub a:hover {
      background: none;
    }

    .nav ul.sub a[aria-current='page'] {
      box-shadow: none;
    }

    .cv-btn {
      margin-top: 1rem;
      align-self: flex-start;
    }

    .site-header.is-open .bars span:nth-child(1) {
      transform: translateY(5.5px) rotate(45deg);
    }
    .site-header.is-open .bars span:nth-child(2) {
      opacity: 0;
    }
    .site-header.is-open .bars span:nth-child(3) {
      transform: translateY(-5.5px) rotate(-45deg);
    }
  }

  @media (max-width: 420px) {
    .brand-sub {
      font-size: 0.65rem;
      letter-spacing: 0.06em;
    }
  }
</style>
