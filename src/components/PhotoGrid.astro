---
// Polaroid-style photo cards in a masonry layout. Clicking a card opens the viewer in PhotoAlbums.
import { photoUrl, type Album } from '../lib/photography';

interface Props {
  album: Album;
  /** Position of this album in the viewer's list */
  albumIndex: number;
  alts: string[];
}
const { album, albumIndex, alts } = Astro.props;
---

<ul class="photos" role="list">
  {album.photos.map((photo, pi) => (
    <li class="card">
      <figure>
        <button
          type="button"
          class="shot"
          data-album={albumIndex}
          data-photo={pi}
          aria-label={`View larger: ${photo.caption ?? `photo ${pi + 1}`}`}
        >
          <img
            src={photoUrl(album, photo, 'card')}
            alt={alts[pi]}
            width={photo.width}
            height={photo.height}
            loading="lazy"
            decoding="async"
          />
        </button>
        {photo.caption && <figcaption>{photo.caption}</figcaption>}
      </figure>
    </li>
  ))}
</ul>

<style>
  /* ---------- Polaroid cards (masonry) ---------- */
  .photos {
    list-style: none;
    margin: 0;
    padding: 0.5rem 0.25rem 0;
    columns: 3 15rem;
    column-gap: clamp(1.25rem, 2.5vw, 2rem);
  }

  .card {
    --tilt: 0deg;
    position: relative;
    break-inside: avoid;
    margin: 0 0 clamp(1.5rem, 3vw, 2.1rem);
    padding-top: 0.4rem; /* room for the tape */
  }

  .card:nth-child(4n + 1) { --tilt: -1.2deg; }
  .card:nth-child(4n + 2) { --tilt: 0.9deg; }
  .card:nth-child(4n + 3) { --tilt: -0.5deg; }
  .card:nth-child(4n + 4) { --tilt: 1.3deg; }

  figure {
    margin: 0;
    padding: 0.6rem 0.6rem 0;
    background: #fff;
    border-radius: 3px;
    box-shadow:
      0 1px 2px rgb(21 35 61 / 0.08),
      0 14px 30px -18px rgb(21 35 61 / 0.45);
    transform: rotate(var(--tilt));
    transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1), box-shadow 0.35s ease;
  }

  /* Washi tape on some cards */
  .card:nth-child(3n + 1)::before {
    content: '';
    position: absolute;
    z-index: 2;
    top: -0.15rem;
    left: 50%;
    width: 4.5rem;
    height: 1.25rem;
    background: rgb(214 196 152 / 0.55);
    box-shadow: 0 1px 2px rgb(21 35 61 / 0.08);
    transform: translateX(-50%) rotate(calc(var(--tilt) * -3));
  }

  .card:nth-child(6n + 4)::before {
    background: rgb(171 192 214 / 0.55);
  }

  .card:hover figure,
  .card:focus-within figure {
    transform: rotate(0deg) translateY(-4px) scale(1.012);
    box-shadow:
      0 2px 4px rgb(21 35 61 / 0.08),
      0 26px 44px -22px rgb(21 35 61 / 0.55);
  }

  .shot {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: #eeece6;
    cursor: zoom-in;
    overflow: hidden;
    border-radius: 2px;
  }

  .shot img {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 0.6s ease;
  }

  .card:hover .shot img {
    transform: scale(1.03);
  }

  .shot:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  figcaption {
    padding: 0.8rem 0.35rem 1rem;
    font-family: var(--serif);
    font-style: italic;
    font-size: 0.98rem;
    line-height: 1.45;
    color: var(--ink);
    text-align: center;
  }

  /* A photo without a caption still gets the polaroid's thicker bottom edge */
  .shot:last-child {
    margin-bottom: 1.6rem;
  }

  @media (prefers-reduced-motion: reduce) {
    figure,
    .shot img {
      transition: none;
    }
  }
</style>
