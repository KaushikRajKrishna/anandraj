---
// Invitation to request a postcard of a sketch or photograph (Photography and Sketching pages).
import { profile } from '../data/profile';

const subject = 'Postcard request';
const body = [
  'Hello Anand,',
  '',
  'I would love a postcard of this sketch or photograph:',
  '',
  'Name for the note:',
  'Postal address:',
  '',
  'Thank you!',
].join('\n');
const mailto = `mailto:${profile.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
---

<aside class="postcard" aria-labelledby="postcard-title">
  <div class="pc-body">
    <p class="pc-eyebrow">Buy your own postcard</p>
    <h2 id="postcard-title">Would you like one as a postcard?</h2>
    <p class="pc-text">
      I am happy to send my sketches and photographs as postcards, each with a short handwritten note and my
      signature. Write to me with the one you would like and where it should go.
    </p>
    <p class="pc-actions">
      <a class="btn" href={mailto}>Request a postcard</a>
      <a class="pc-mail" href={`mailto:${profile.email}`}>{profile.email}</a>
    </p>
  </div>
  <div class="pc-stamp" aria-hidden="true">
    <span>AR</span>
  </div>
</aside>

<style>
  .postcard {
    position: relative;
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    padding: clamp(1.4rem, 3vw, 2rem) clamp(1.25rem, 3vw, 2.25rem);
    background: #fffdf8;
    border-radius: 6px;
    box-shadow: 0 1px 2px rgb(21 35 61 / 0.06), 0 18px 40px -28px rgb(21 35 61 / 0.45);
    /* Airmail stripes around the edge */
    border: 6px solid transparent;
    border-image: repeating-linear-gradient(
        -45deg,
        #c9584f 0 10px,
        transparent 10px 18px,
        #3e5f86 18px 28px,
        transparent 28px 36px
      )
      8;
  }

  .pc-body {
    flex: 1;
    min-width: 0;
  }

  .pc-eyebrow {
    margin: 0 0 0.35rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent);
  }

  h2 {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(1.4rem, 2.6vw, 1.75rem);
    font-weight: 500;
    color: var(--ink);
  }

  .pc-text {
    margin: 0.6rem 0 0;
    max-width: 44rem;
    font-family: var(--serif);
    font-style: italic;
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--ink);
  }

  .pc-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.25rem;
    margin: 1.25rem 0 0;
  }

  .pc-mail {
    font-size: 0.92rem;
    color: var(--accent-strong);
    overflow-wrap: anywhere;
  }

  /* Perforated stamp */
  .pc-stamp {
    flex: none;
    display: grid;
    place-items: center;
    width: 4.25rem;
    height: 5rem;
    background: var(--accent-strong);
    color: #fff;
    font-family: var(--serif);
    font-weight: 600;
    font-size: 1.35rem;
    /* Dotted white edge reads as perforations */
    border: 4px dotted #fffdf8;
    box-shadow: 0 0 0 1px var(--accent-strong), 0 2px 6px -2px rgb(21 35 61 / 0.4);
    transform: rotate(4deg);
  }

  .pc-stamp span {
    display: grid;
    place-items: center;
    width: calc(100% - 8px);
    height: calc(100% - 8px);
    border: 1px solid rgb(255 255 255 / 0.55);
  }

  @media (max-width: 539px) {
    .pc-stamp {
      position: absolute;
      top: 0.9rem;
      right: 0.9rem;
      width: 3.1rem;
      height: 3.7rem;
      font-size: 1rem;
    }

    h2 {
      padding-right: 3.5rem;
    }
  }
</style>
