---
// Text captions, videos and links for a Beyond Academia section.
import type { GalleryItem } from '../data/beyondAcademia';

interface Props {
  items: GalleryItem[];
}
const { items } = Astro.props;

/** YouTube / Vimeo page URL → embeddable URL; anything else is treated as a video file. */
function embedUrl(src: string): string | null {
  const yt = src.match(/(?:youtube\.com\/(?:watch\?v=|shorts\/|embed\/)|youtu\.be\/)([\w-]{11})/);
  if (yt) return `https://www.youtube-nocookie.com/embed/${yt[1]}`;
  const vimeo = src.match(/vimeo\.com\/(?:video\/)?(\d+)/);
  if (vimeo) return `https://player.vimeo.com/video/${vimeo[1]}`;
  return null;
}

const hostOf = (href: string) => {
  try {
    return new URL(href).hostname.replace(/^www\./, '');
  } catch {
    return '';
  }
};

---

<ul class="gallery" role="list">
  {items.map((item) => (
    <li class:list={['g-item', `is-${item.type}`]}>
      {item.type === 'video' && (
        <div class="media video">
          {embedUrl(item.src) ? (
            <iframe
              src={embedUrl(item.src)!}
              title={item.caption}
              loading="lazy"
              allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen"
              allowfullscreen
            />
          ) : (
            <video src={item.src} controls preload="metadata" />
          )}
        </div>
      )}

      {item.type === 'link' && (
        <a class="media link-card" href={item.href} target="_blank" rel="noopener noreferrer">
          <span class="link-plain">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M10 14a5 5 0 0 0 7 0l3-3a5 5 0 0 0-7-7l-1 1M14 10a5 5 0 0 0-7 0l-3 3a5 5 0 0 0 7 7l1-1" /></svg>
          </span>
          <span class="link-title">
            {item.title}
            <span class="ext" aria-hidden="true">↗</span>
            <span class="visually-hidden">(opens in a new tab)</span>
          </span>
          {hostOf(item.href) && <span class="link-host">{hostOf(item.href)}</span>}
        </a>
      )}

      <div class="caption">
        <p class="c-text">{item.caption}</p>
        {(item.source || item.date) && (
          <p class="c-meta">
            {item.type === 'video' && <span class="kind">Video</span>}
            {item.type === 'link' && <span class="kind">Link</span>}
            {[item.source, item.date].filter(Boolean).join(' · ')}
          </p>
        )}
        {!(item.source || item.date) && item.type !== 'image' && (
          <p class="c-meta"><span class="kind">{item.type === 'video' ? 'Video' : 'Link'}</span></p>
        )}
      </div>
    </li>
  ))}
</ul>

<style>
  .gallery {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 16.5rem), 1fr));
    gap: clamp(1.25rem, 3vw, 2rem);
    align-items: start;
  }

  .g-item {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
  }

  .media {
    display: block;
    width: 100%;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--rule);
    box-shadow: 0 1px 2px rgb(21 35 61 / 0.05), 0 10px 24px -18px rgb(21 35 61 / 0.35);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .link-plain svg {
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .media:hover,
  .media:focus-visible {
    transform: translateY(-3px);
    box-shadow: 0 1px 2px rgb(21 35 61 / 0.06), 0 18px 34px -18px rgb(21 35 61 / 0.45);
  }

  .media:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  /* Videos */
  .video {
    aspect-ratio: 16 / 9;
    background: #0d1626;
  }

  .video iframe,
  .video video {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
  }

  /* Links */
  .link-card {
    color: inherit;
    text-decoration: none;
  }

  .link-plain {
    display: grid;
    place-items: center;
    aspect-ratio: 16 / 9;
    background: var(--accent-soft);
    color: var(--accent);
  }

  .link-plain svg {
    width: 2rem;
    height: 2rem;
    stroke-width: 1.6;
  }

  .link-title {
    display: block;
    padding: 0.9rem 1rem 0.2rem;
    font-family: var(--serif);
    font-size: 1.05rem;
    line-height: 1.35;
    color: var(--ink);
  }

  .ext {
    color: var(--accent);
    margin-left: 0.2rem;
  }

  .link-host {
    display: block;
    padding: 0 1rem 0.9rem;
    font-size: 0.82rem;
    color: var(--muted);
  }

  /* Captions */
  .caption {
    padding-inline: 0.15rem;
  }

  .c-text {
    margin: 0;
    font-family: var(--serif);
    font-size: 1.05rem;
    line-height: 1.4;
    color: var(--ink);
  }

  .c-meta {
    margin: 0.3rem 0 0;
    font-size: 0.8rem;
    color: var(--muted);
    letter-spacing: 0.02em;
  }

  .kind {
    display: inline-block;
    margin-right: 0.45rem;
    padding: 0.05rem 0.4rem;
    border-radius: 3px;
    background: var(--accent-soft);
    color: var(--accent-strong);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (prefers-reduced-motion: reduce) {
    .media {
      transition: none;
    }
  }
</style>
