---
// Decorative line illustration for the Home hero: a platform delivery rider
// in front of a city skyline and metro viaduct, with a dashed migration route.
// Shown when no portrait is set in profile.ts.
---

<svg class="hero-art" viewBox="0 0 320 400" preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id="ha-sky" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="var(--accent-soft)" />
      <stop offset="1" stop-color="var(--surface-2)" />
    </linearGradient>
    <clipPath id="ha-clip"><rect width="320" height="400" rx="6" /></clipPath>
  </defs>

  <g clip-path="url(#ha-clip)">
    <rect width="320" height="400" fill="url(#ha-sky)" />

    <!-- sun -->
    <circle cx="232" cy="96" r="38" fill="var(--surface)" />
    <circle cx="232" cy="96" r="38" fill="none" stroke="var(--accent)" stroke-opacity=".25" />

    <!-- migration route: dashed path arriving from afar -->
    <path d="M-10 70 C 60 40, 110 120, 150 150 S 230 190, 300 175" fill="none" stroke="var(--accent)" stroke-width="1.4" stroke-dasharray="4 5" opacity=".7" />
    <circle cx="150" cy="150" r="3.5" fill="var(--accent)" />
    <circle cx="300" cy="175" r="3.5" fill="var(--ink)" />

    <!-- skyline, back row -->
    <g fill="var(--ink)" opacity=".10">
      <rect x="10" y="190" width="34" height="140" />
      <rect x="48" y="170" width="26" height="160" />
      <rect x="196" y="160" width="30" height="170" />
      <rect x="262" y="185" width="44" height="145" />
    </g>
    <!-- skyline, front row -->
    <g fill="var(--ink)" opacity=".18">
      <rect x="0" y="230" width="40" height="100" />
      <rect x="74" y="205" width="40" height="125" />
      <rect x="118" y="225" width="28" height="105" />
      <rect x="160" y="195" width="34" height="135" />
      <rect x="228" y="215" width="36" height="115" />
      <rect x="282" y="240" width="40" height="90" />
    </g>
    <!-- windows -->
    <g fill="var(--surface)" opacity=".7">
      <rect x="82" y="214" width="6" height="8" /><rect x="96" y="214" width="6" height="8" />
      <rect x="82" y="230" width="6" height="8" /><rect x="96" y="246" width="6" height="8" />
      <rect x="168" y="206" width="6" height="8" /><rect x="180" y="206" width="6" height="8" />
      <rect x="168" y="222" width="6" height="8" /><rect x="236" y="226" width="6" height="8" />
      <rect x="250" y="242" width="6" height="8" />
    </g>

    <!-- metro viaduct -->
    <g stroke="var(--ink)" stroke-opacity=".55" stroke-width="2" fill="none">
      <path d="M0 262 H320" />
      <path d="M0 268 H320" stroke-width="1" />
      <path d="M40 268 V330 M120 268 V330 M200 268 V330 M280 268 V330" stroke-width="5" stroke-opacity=".35" />
    </g>
    <!-- metro train -->
    <g>
      <rect x="196" y="244" width="96" height="16" rx="4" fill="var(--accent)" />
      <g fill="var(--surface)" opacity=".85">
        <rect x="204" y="248" width="10" height="6" rx="1" /><rect x="220" y="248" width="10" height="6" rx="1" />
        <rect x="236" y="248" width="10" height="6" rx="1" /><rect x="252" y="248" width="10" height="6" rx="1" />
        <rect x="268" y="248" width="10" height="6" rx="1" />
      </g>
    </g>

    <!-- road -->
    <rect x="0" y="330" width="320" height="70" fill="var(--ink)" opacity=".9" />
    <path d="M0 366 H320" stroke="var(--bg)" stroke-width="2" stroke-dasharray="16 12" opacity=".55" />

    <!-- delivery rider -->
    <g transform="translate(70 0)">
      <!-- wheels -->
      <circle cx="40" cy="342" r="15" fill="none" stroke="var(--bg)" stroke-width="4" />
      <circle cx="108" cy="342" r="15" fill="none" stroke="var(--bg)" stroke-width="4" />
      <circle cx="40" cy="342" r="3" fill="var(--bg)" />
      <circle cx="108" cy="342" r="3" fill="var(--bg)" />
      <!-- scooter body -->
      <path d="M40 342 L58 318 H88 L108 342" fill="none" stroke="var(--bg)" stroke-width="4" stroke-linejoin="round" />
      <path d="M50 326 H92 L98 336 H48 Z" fill="var(--accent)" />
      <path d="M96 318 L104 296 H114" fill="none" stroke="var(--bg)" stroke-width="4" stroke-linecap="round" />
      <!-- delivery box -->
      <rect x="26" y="280" width="34" height="32" rx="3" fill="var(--accent-strong)" />
      <path d="M26 292 H60" stroke="var(--bg)" stroke-opacity=".5" stroke-width="1.5" />
      <!-- rider -->
      <path d="M66 318 L74 296 L86 270" fill="none" stroke="var(--bg)" stroke-width="9" stroke-linecap="round" stroke-linejoin="round" />
      <path d="M84 280 L104 296" fill="none" stroke="var(--bg)" stroke-width="6" stroke-linecap="round" />
      <path d="M74 300 L94 312 L96 326" fill="none" stroke="var(--bg)" stroke-width="7" stroke-linecap="round" stroke-linejoin="round" />
      <circle cx="90" cy="256" r="11" fill="var(--bg)" />
      <path d="M79 254 A11 11 0 0 1 101 254 Z" fill="var(--accent)" />
    </g>
  </g>
</svg>

<style>
  .hero-art {
    width: 100%;
    height: auto;
    display: block;
    border-radius: var(--radius);
    border: 1px solid var(--rule);
  }
</style>
